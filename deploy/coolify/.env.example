# Buzz relay on Coolify — environment for the `relay` Application resource.
#
# Postgres/Redis/MinIO are separate Coolify resources (see README.md), so
# there is no POSTGRES_*/REDIS_PASSWORD/etc. here — only what the relay
# container itself needs. In Coolify, set these as the app resource's
# Environment Variables (ideally via environment-level Shared Variables so
# the same secret can be referenced from multiple resources). This file is
# also usable locally for `docker compose -f docker-compose.yml config`.

# Image published by the public image pipeline. Use `:main` for pre-release
# testing. Pin `:sha-<7>` or a semver release tag for production.
BUZZ_IMAGE=ghcr.io/block/buzz:main

# Public host name and derived URLs.
BUZZ_DOMAIN=buzz.example.com
RELAY_URL=wss://buzz.example.com
BUZZ_MEDIA_BASE_URL=https://buzz.example.com/media
BUZZ_MEDIA_SERVER_DOMAIN=buzz.example.com
BUZZ_CORS_ORIGINS=https://buzz.example.com

# Production defaults. Closed relay mode requires RELAY_OWNER_PUBKEY and a
# stable relay key.
BUZZ_REQUIRE_AUTH_TOKEN=true
BUZZ_REQUIRE_RELAY_MEMBERSHIP=true
BUZZ_ALLOW_NIP_OA_AUTH=true
BUZZ_AUTO_MIGRATE=true
BUZZ_GIT_CONFORMANCE_PROBE=true
RUST_LOG=buzz_relay=info,buzz_db=info,buzz_auth=info,buzz_pubsub=info,tower_http=info

# Owner identity. Set to a 64-character hex Nostr pubkey.
RELAY_OWNER_PUBKEY=CHANGE_ME_OWNER_PUBKEY_HEX

# Stable secrets. Generate once, keep them in Coolify's Shared Variables, and
# back them up securely — do not let these rotate on redeploy.
BUZZ_RELAY_PRIVATE_KEY=CHANGE_ME_64_HEX_PRIVATE_KEY
BUZZ_GIT_HOOK_HMAC_SECRET=CHANGE_ME_RANDOM_64_HEX

# From the Coolify PostgreSQL resource's connection details (internal URL).
DATABASE_URL=postgres://buzz:CHANGE_ME@postgres.internal:5432/buzz

# From the Coolify Redis resource's connection details (internal URL,
# password-protected).
REDIS_URL=redis://:CHANGE_ME@redis.internal:6379

# From the Coolify MinIO resource. Self-hosted MinIO on Coolify's internal
# Docker network resolves by service name, not by <bucket>.subdomain — keep
# BUZZ_S3_ADDRESSING_STYLE=path. Create the `buzz-media` bucket once via the
# MinIO console (or `mc`) and set its access policy to private/none.
BUZZ_S3_ENDPOINT=http://minio.internal:9000
BUZZ_S3_ACCESS_KEY=CHANGE_ME_RANDOM_ACCESS_KEY
BUZZ_S3_SECRET_KEY=CHANGE_ME_RANDOM_SECRET_KEY
BUZZ_S3_BUCKET=buzz-media
BUZZ_S3_ADDRESSING_STYLE=path
